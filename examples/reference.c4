// diagram v1
// Reference diagram: one invented system that uses every feature of the viewer.
// Keep it stable. Testing a new version of the skill on this same file lets
// the person who validates compare like with like. test/reference.test.mjs
// checks that it stays valid and still covers every kind, state, mark, icon
// path and limit; examples/REFERENCE.md says where each feature sits.
//
// Story: Contoso Parcels, an invented parcel delivery company, is halfway through moving parcel
// tracking from a legacy AWS account to Azure. Validate with:
//   node check.mjs examples/reference.c4
model {
  customer = person 'Customer' {
    description 'follows a parcel on the web'
  }
  oncall = person 'On-call engineer'
  carriers = external 'Partner carriers' {
    description 'push scan events by webhook'
  }
  psp = external 'Card processor' {
    icon none
  }

  azure = system 'Azure' {
    prod = system 'sub-contoso-prod' {
      edge = system 'rg-edge' {
        frontdoor = service 'Front Door' {
          #done
          technology 'Azure Front Door'
          metadata {
            proof 'curl -I https://track.example → 200'
          }
        }
        waf = component 'WAF policy' {
          #done
          technology 'Azure Web Application Firewall'
        }
        dns = data 'DNS zone contoso.example' {
          description 'CNAME track → Front Door'
        }
        frontdoor -> waf 'filters'
      }
      web = system 'rg-web' {
        swa = system 'Static Web App' {
          technology 'Azure Static Web Apps'
          page = component 'TrackParcel.tsx' {
            #impacted
            metadata {
              why 'reads live updates from SignalR instead of polling'
            }
          }
          map = component 'MapView.tsx'
          status = component '配送状态组件' {
            description '中文界面的包裹状态标签，测试换行'
          }
          page -> map 'position'
          page -> status 'state'
        }
      }
      tracking = system 'rg-tracking' {
        vnet = system 'vnet-tracking' {
          app = system 'snet-app' {
            apim = service 'API Management' {
              #planned
              description 'single entry for carriers and the web app'
              metadata {
                why 'carriers keep one URL across the move'
                decided 'user'
              }
            }
            functions = service 'Functions' {
              #done #new
              description 'ingest scan events, validate, publish'
              metadata {
                proof 'func test 58/58'
                count '3 functions'
              }
            }
            bus = data 'Service Bus' {
              #doing #new
              description 'topic parcel-scans, 2 subscriptions'
            }
            aks = machine 'AKS cluster' {
              #doing #new
              technology 'Azure Kubernetes Service'
            }
            signalr = service 'SignalR' {
              #planned #new
              description 'pushes parcel updates to open pages'
            }
            gateway = service 'Application Gateway' {
              technology 'Azure Application Gateway'
            }
            identity = component 'Managed identity' {
              #done #new
              icon azure:entra-managed-identities
            }
            apim -> functions 'POST /scans'
            functions -[async]-> bus 'publish'
            bus -[async]-> aks 'consume'
            aks -> signalr 'broadcast'
            gateway -> aks 'ingress'
          }
          data = system 'snet-data' {
            cosmos = data 'Cosmos DB' {
              #deviation #new
              description 'parcel timeline, one document per parcel'
              metadata {
                why 'PostgreSQL was planned; 40k writes/s at peak fit Cosmos better'
                decided 'user'
              }
            }
            redis = data 'Cache for Redis' {
              #done #new
              technology 'Azure Cache for Redis'
            }
            endpoint = component 'Private endpoint'
          }
          app.aks -> data.cosmos 'parcel timeline'
          app.aks -> data.redis 'last position'
          app.functions -> data.redis 'dedupe'
        }
        vault = service 'Key Vault' {
          #done
        }
        monitoring = system 'Monitoring' {
          insights = service 'Application Insights' {
            #doing
          }
          logs = data 'Log Analytics' {
            technology 'Azure Log Analytics'
          }
          insights -[data]-> logs 'export' {
            #assumed
            metadata {
              source 'examples/REFERENCE.md: monitoring design sketch'
            }
          }
        }
        vnet.app.functions -> vault 'secrets'
        vnet.app.aks -> monitoring.insights 'traces'
      }
      dispatch = system 'Dispatch application' {
        description 'registers deliveries and schedules their routes'
        front = system 'Frontend' {
          technology 'React, TypeScript'
          board = component 'DispatchBoard.tsx' {
            description 'delivery form and route assignment status'
          }
          client = component 'api-client.ts' {
            description 'submits commands and refreshes the delivery list'
          }
          board -> client 'submit delivery'
        }
        back = system 'Backend' {
          technology 'Node.js, TypeScript'
          api = service 'Dispatch API' {
            description 'authenticates POST /deliveries and returns the new delivery id'
          }
          validate = component 'Validate delivery' {
            description 'normalizes the address and checks that the parcel exists'
          }
          register = component 'Register delivery' {
            description 'stores a pending delivery and queues its id for route planning'
          }
          queue = data 'Route planning queue' {
            technology 'RabbitMQ'
            description 'durable jobs; retries can deliver the same delivery id again'
          }
          worker = service 'Route planning worker' {
            description 'assigns a depot route; skips deliveries that are already scheduled'
          }
          api -> validate 'validate request'
          api -> register 'register valid request'
          register -[async]-> queue 'delivery id'
          queue -[async]-> worker 'plan route'
        }
        front.client -> back.api 'POST /deliveries'
      }
      shared = system 'rg-shared' {
        registry = data 'Container Registry' {
          technology 'Azure Container Registry'
        }
        entra = service 'Entra ID' {
          technology 'Microsoft Entra ID'
        }
      }
      edge.frontdoor -> web.swa.page 'static files'
      edge.frontdoor -> tracking.vnet.app.apim 'API calls'
      tracking.vnet.app.aks -> shared.registry 'pulls images'
      tracking.vnet.app.identity -> shared.entra 'tokens'
    }
    dev = system 'sub-contoso-dev' {
      #frozen
      metadata {
        why 'shared with another team until the move is done'
      }
      sandbox = machine 'sandbox VM' {
        description 'manual tests only'
      }
    }
  }

  aws = system 'AWS' {
    legacy = system 'account legacy-prod' {
      region = system 'eu-west-1' {
        tracking = system 'Tracking v1' {
          #doing #removed
          gateway = service 'API Gateway' {
            #done #removed
          }
          ingest = service 'Lambda' {
            #done #removed
            description 'ingest-scans, Node 18'
          }
          queue = data 'SQS queue' {
            #done #removed
          }
          table = data 'DynamoDB' {
            #waiting #removed
            description 'parcel timeline, 2 years of history'
            metadata {
              why 'deleting it drops history: export to the data lake first?'
              decided 'user'
            }
          }
          gateway -> ingest 'invoke' {
            #done
          }
          ingest -> queue 'enqueue'
          queue -> table 'write'
        }
        billing = system 'Billing' {
          #frozen
          metadata {
            why 'out of scope: billing moves next quarter'
          }
          api = service 'invoice-api' {
            technology 'AWS Fargate'
          }
          db = data 'RDS PostgreSQL' {
            technology 'Amazon RDS for PostgreSQL'
          }
          bucket = data 'S3 invoices bucket'
          api -> db 'invoices'
          api -> bucket 'PDF'
        }
      }
      iam = component 'IAM roles' {
        technology 'AWS IAM'
      }
    }
  }

  data = system 'Data & analytics' {
    gcp = system 'GCP' {
      warehouse = data 'BigQuery' {
        description 'parcels, scans, delivery times'
      }
      run = service 'Cloud Run' {
        description 'export API for partners'
      }
      pubsub = data 'Pub/Sub' {
        #planned
      }
      run -> warehouse 'queries'
    }
    pipelines = system 'Pipelines' {
      ingest = system 'Ingest' {
        connect = service 'Kafka Connect' {
          technology 'Apache Kafka Connect'
        }
        topic = data 'parcel-events' {
          technology 'Apache Kafka'
          description 'compacted, 7 days'
        }
        connect -> topic 'produce'
      }
      transform = system 'Transform' {
        dbt = component 'dbt project' {
          technology 'dbt'
        }
        model = component 'parcels.sql' {
          #doing
          description 'adds the Azure source next to the AWS one'
        }
        dbt -> model 'runs'
      }
      ingest.topic -> transform.dbt 'raw events'
    }
    dispatchdb = data 'Dispatch database' {
      technology 'PostgreSQL 16'
      description 'operational delivery records, separate from the analytics warehouse'
      customers = data 'customers' {
        description 'one recipient per customer record'
        id = data 'id' {
          description 'uuid, primary key'
        }
        email = data 'email' {
          description 'text, not null, unique'
        }
        name = data 'name' {
          description 'text, not null'
        }
      }
      parcels = data 'parcels' {
        description 'one row per parcel; each parcel belongs to a customer'
        id = data 'id' {
          description 'uuid, primary key'
        }
        tracking_code = data 'tracking_code' {
          description 'varchar(32), not null, unique'
        }
        customer_id = data 'customer_id' {
          description 'uuid, not null, foreign key to customers.id'
        }
        created_at = data 'created_at' {
          description 'timestamptz, not null, default now()'
        }
      }
      deliveries = data 'deliveries' {
        description 'one row per delivery attempt; a parcel can have several attempts'
        id = data 'id' {
          description 'uuid, primary key'
        }
        parcel_id = data 'parcel_id' {
          description 'uuid, not null, foreign key to parcels.id'
        }
        route_code = data 'route_code' {
          description 'text, nullable until the route planning worker assigns a route'
        }
        status = data 'status' {
          description 'text, not null, check: pending / scheduled / cancelled'
        }
        scheduled_at = data 'scheduled_at' {
          description 'timestamptz, nullable until scheduled'
        }
      }
      parcels.customer_id -> customers.id 'references (many to one)'
      deliveries.parcel_id -> parcels.id 'references (many to one)'
    }
    bi = system 'BI' {
      kpis = service 'Delivery KPIs' {
        technology 'Metabase'
      }
      eta = component 'ETA model' {
        #blocked
        technology 'PyTorch'
        metadata {
          why 'GPU quota request still open'
          ticket 'OPS-311'
        }
      }
    }
    pipelines.transform.model -> gcp.warehouse 'load'
    bi.kpis -> gcp.warehouse 'reads'
    gcp.warehouse -> bi.eta 'training set'
  }

  ops = system 'Operations' {
    depots = system 'Depots' {
      north = system 'Depot North' {
        scanners = hardware 'Handheld scanners' {
          description '120 devices, Android'
        }
        sorter = machine 'Sorter controller' {
          technology 'Siemens S7'
        }
        edgebox = machine 'Edge gateway' {
          #impacted
          technology 'Raspberry Pi'
          metadata {
            why 'its target URL changes to API Management'
          }
        }
        gpu = hardware 'GPU node' {
          #waiting #new
          technology 'NVIDIA L4'
          description 'for ETA training, waiting for purchase approval'
        }
        routing = service 'Route planning jobs' {
          description 'nightly, builds the drivers rounds'
        }
        scanners -> edgebox 'scans (Wi-Fi)'
        routing -> sorter 'belt plan'
        sorter -> edgebox 'belt events'
      }
    }
    delivery = system 'CI/CD' {
      workflow = component 'deploy.yml' {
        #planned #assumed
        technology 'GitHub Actions'
        metadata {
          source 'examples/REFERENCE.md: CI/CD design sketch'
        }
      }
      infra = component 'main.tf' {
        #doing
        description 'Azure resources for tracking'
      }
      argo = service 'Argo CD'
      workflow -> argo 'new image'
      workflow -> infra 'plan / apply'
    }
    docs = system 'Docs' {
      runbook = doc 'runbook-tracking.md' {
        #planned
      }
      adr = doc 'ADR-012 tracking on Azure' {
        #done
        metadata {
          decided 'user'
          proof 'merged in docs repo'
        }
      }
      backlog = doc 'Mise en production à étapes' {
        description 'déroulé validé : bascule par dépôt, retour arrière possible'
      }
    }
  }

  // People and partners
  customer -> azure.prod.edge.frontdoor 'tracks a parcel'
  oncall -> ops.docs.runbook 'follows'
  carriers -> azure.prod.tracking.vnet.app.apim 'webhooks' {
    #planned
  }
  carriers -> aws.legacy.region.tracking.gateway 'webhooks (old)' {
    #removed
  }
  psp -> aws.legacy.region.billing.api 'payment events'

  // Depots to the cloud
  ops.depots.north.edgebox -> azure.prod.tracking.vnet.app.apim 'scans' {
    #doing
  }
  ops.depots.north.edgebox -> aws.legacy.region.tracking.gateway 'scans (old)' {
    #removed
  }
  data.bi.eta -> ops.depots.north.gpu 'trains on' {
    #blocked
  }

  // Delivery
  ops.delivery.argo -> azure.prod.tracking.vnet.app.aks 'syncs'
  ops.delivery.infra -> azure.prod 'provisions'
  ops.delivery.workflow -> azure.prod.shared.registry 'pushes images'

  customer -> azure.prod.dispatch.front.board 'registers delivery'
  azure.prod.dispatch.back.validate -> data.dispatchdb.parcels 'check parcel'
  azure.prod.dispatch.back.register -> data.dispatchdb.deliveries 'INSERT pending delivery'
  azure.prod.dispatch.back.worker -> data.dispatchdb.deliveries 'UPDATE route and status'

  // Analytics: three links between Azure and the data platform
  azure.prod.tracking.vnet.app.bus -[async]-> data.pipelines.ingest.connect 'scan events'
  azure.prod.tracking.vnet.data.cosmos -[data]-> data.pipelines.ingest.connect 'change feed'
  azure.prod.tracking.monitoring.logs -[data]-> data.gcp.warehouse 'ops metrics'
  aws.legacy.region.tracking.table -> data.pipelines.ingest.connect 'history export' {
    #waiting
  }
}

views {
  dynamic view registerDelivery {
    title 'Register and plan a delivery'
    customer -> azure.prod.dispatch.front.board 'fills delivery form'
    azure.prod.dispatch.front.board -> azure.prod.dispatch.front.client 'submit delivery'
    azure.prod.dispatch.front.client -> azure.prod.dispatch.back.api 'POST /deliveries'
    azure.prod.dispatch.back.api -> azure.prod.dispatch.back.validate 'validate request'
    azure.prod.dispatch.back.validate -> data.dispatchdb.parcels 'check parcel'
    azure.prod.dispatch.back.api -> azure.prod.dispatch.back.register 'register valid request'
    azure.prod.dispatch.back.register -> data.dispatchdb.deliveries 'INSERT pending delivery'
    azure.prod.dispatch.back.register -> azure.prod.dispatch.back.queue 'delivery id'
    azure.prod.dispatch.back.queue -> azure.prod.dispatch.back.worker 'plan route'
    azure.prod.dispatch.back.worker -> data.dispatchdb.deliveries 'UPDATE route and status'
  }
  dynamic view scanToCustomer {
    title 'A scan, from depot to customer'
    ops.depots.north.scanners -> ops.depots.north.edgebox 'scan'
    ops.depots.north.edgebox -> azure.prod.tracking.vnet.app.apim 'POST /scans'
    azure.prod.tracking.vnet.app.apim -> azure.prod.tracking.vnet.app.functions 'validate'
    azure.prod.tracking.vnet.app.functions -> azure.prod.tracking.vnet.app.bus 'publish'
    azure.prod.tracking.vnet.app.bus -> azure.prod.tracking.vnet.app.aks 'consume'
    parallel {
      azure.prod.tracking.vnet.app.aks -> azure.prod.tracking.vnet.data.cosmos 'append to timeline'
      azure.prod.tracking.vnet.app.aks -> azure.prod.tracking.vnet.app.signalr 'broadcast'
    }
    azure.prod.tracking.vnet.app.signalr -> azure.prod.web.swa.page 'live update'
  }
}
